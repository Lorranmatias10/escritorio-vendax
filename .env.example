# Copie para .env.local. Segredos ficam só no servidor (nunca use o prefixo NEXT_PUBLIC_).

# Banco: vazio = PostgreSQL embutido (PGlite) em .data/pglite. Na nuvem: o Postgres do EasyPanel.
# DATABASE_URL=postgres://postgres:SENHA@HOST:PORTA/escritorio
# PGLITE_DIR=.data/pglite

# Login: "ligado" exige e-mail e senha (produção). Sem isso, modo demonstração com "Ver como".
# VX_LOGIN=ligado
# Endereço público do app (links de acesso, OAuth do Google, cookie seguro em https)
# VX_URL_BASE=https://escritorio.seudominio.com.br

# IA: "simulado" (padrão) roda o adaptador local de demonstração.
AI_PROVEDOR=simulado
# AI_MODELO=
# ANTHROPIC_API_KEY=
# VX_CLAUDE_MODELO=claude-haiku-5-5

# Rotinas A1. Após configurar as contas e aprovar a ativação, use "ligado".
VX_ROTINAS=desligado
VX_ROTINAS_LIMITE_HORA=20

# Espaço exclusivo para o SDR da operação interna (não use um espaço de cliente).
# CRM_VENDAX_ESPACO_COMERCIAL_ID=
# Leitura por WABA, número ou funil: use apenas endpoints e credenciais de consulta por recurso.
# NEXTTAGS_READER_URL=
# NEXTTAGS_READER_TOKEN=
# VENDAX_APP_READER_URL=
# VENDAX_APP_READER_TOKEN=
